# Backend dev environment — copy to .env and fill in.
# .env is gitignored. Never commit real values; production values live in the
# password manager and on the server under C:\apps\erp\shared\.

# Local dev database. These credentials match erp/docker-compose.yml
# (POSTGRES_USER / PASSWORD / DB are all "erp"), so this line works as-is.
DATABASE_URL=postgres://erp:erp@localhost:5432/erp

# Backend port. Keep 3002 — erp/frontend/next.config.ts rewrites /api to
# http://localhost:3002/api, so the frontend breaks on any other port.
PORT=3002

# Session signing secret. The backend exits at startup if this is missing.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-generate-your-own
