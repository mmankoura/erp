# ERP Backend Production Environment
# Copy to: C:\apps\erp\shared\.env.backend
# Then: copy C:\apps\erp\shared\.env.backend C:\apps\erp\current\backend\.env.production
#
# IMPORTANT: Replace all placeholder values before use.
# Do NOT commit this file with real passwords to git.

# Database (erp_app user — limited privileges, not superuser)
DATABASE_URL=postgres://erp_app:CHANGE_ME_STRONG_PASSWORD@localhost:5432/erp_production

# Server — bind to localhost only, IIS handles external traffic
PORT=3002
HOST=127.0.0.1
NODE_ENV=production

# Session secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_GENERATE_64_CHAR_RANDOM_STRING

# CORS — the URL users access the ERP from
CORS_ORIGIN=http://erp.company.local
